---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { prisma } from '../lib/prisma';

const services = await prisma.service.findMany({ orderBy: { order: 'asc' } });

const iconMap: Record<string, string> = {
  'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  'calculator': '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><line x1="8" y1="10" x2="8" y2="10.01"/><line x1="12" y1="10" x2="12" y2="10.01"/><line x1="16" y1="10" x2="16" y2="10.01"/><line x1="8" y1="14" x2="8" y2="14.01"/><line x1="12" y1="14" x2="12" y2="14.01"/><line x1="8" y1="18" x2="8" y2="18.01"/><line x1="12" y1="18" x2="12" y2="18.01"/>',
  'users': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'rocket': '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  'shield-check': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  'search': '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  'folder': '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
  'briefcase': '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  'trending-up': '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  'bar-chart': '<line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/>',
  'map-pin': '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  'palette': '<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.46 2 12 2z"/>'
};


// Helper para formatear precios variados de servicios de manera inteligente
function formatServicePrice(rawPrice?: string | null) {
  if (!rawPrice || !rawPrice.trim()) return null;
  const p = rawPrice.trim();
  
  if (/^(valor\s+)?sujet[oa]\s+a\s+evaluaci[oó]n|consultar|a\s+convenir$/i.test(p)) {
    return { type: 'evaluation-only', amount: 'Sujeto a evaluación', condition: null };
  }

  const evalIdx = p.toLowerCase().indexOf('sujet');
  if (evalIdx > 0) {
    return {
      type: 'amount-with-condition',
      amount: p.substring(0, evalIdx).trim(),
      condition: 'Sujeto a evaluación'
    };
  }

  return { type: 'standard', amount: p, condition: null };
}

const steps = [
  { num: '01', title: 'Conversemos', desc: 'Cuéntame sobre tu negocio y tus necesidades contables. Agendemos una llamada o reunión.' },
  { num: '02', title: 'Plan personalizado', desc: 'Diseño un plan de trabajo adaptado a tu empresa, con plazos y entregables claros.' },
  { num: '03', title: 'Manos a la obra', desc: 'Me encargo de tu contabilidad mientras tú te enfocas en hacer crecer tu negocio.' },
  { num: '04', title: 'Seguimiento continuo', desc: 'Recibes informes periódicos y asesoría constante para tomar las mejores decisiones.' },
];
---

<Layout title="Servicios | Asesorías Borotto" description="Servicios de contabilidad, declaración de impuestos, remuneraciones, asesoría tributaria y auditoría financiera.">
  <Header />
  <main>
    <Hero
      title='Servicios <span class="accent">profesionales</span>'
      subtitle="Soluciones contables integrales para emprendedores y pymes. Tu tranquilidad financiera es mi prioridad."
      compact={true}
      ctaPrimary={{ text: 'Ver Planes', href: '/planes' }}
      ctaSecondary={{ text: 'Contactar', href: '/contacto' }}
    />

    <!-- Services Grid -->
    <section class="section">
      <div class="container">
        <div class="services-detail-grid">
          {services.map((service, i) => (
            <div class={`service-detail-card reveal delay-${Math.min(i + 1, 6)}`}>
              <!-- Top: Icon & Title -->
              <div class="service-card-top">
                <div class="service-icon-box">
                  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <Fragment set:html={iconMap[service.icon] || iconMap['file-text']} />
                  </svg>
                </div>
                <h3 class="service-name">{service.name}</h3>
              </div>

              <!-- Dedicated Pricing Box -->
              {(() => {
                const priceInfo = formatServicePrice(service.price);
                if (!priceInfo) return null;
                if (priceInfo.type === 'evaluation-only') {
                  return (
                    <div class="service-pricing-box evaluation">
                      <div class="pricing-box-label">Modalidad</div>
                      <div class="pricing-box-val-row">
                        <span class="pricing-eval-title">Cotización a Medida</span>
                        <span class="pricing-eval-badge">Sujeto a evaluación</span>
                      </div>
                    </div>
                  );
                }
                return (
                  <div class="service-pricing-box">
                    <div class="pricing-box-label">Inversión Estimada</div>
                    <div class="pricing-box-val-row">
                      <span class="pricing-amount">{priceInfo.amount}</span>
                      {priceInfo.condition && (
                        <span class="pricing-eval-badge">{priceInfo.condition}</span>
                      )}
                    </div>
                  </div>
                );
              })()}

              <!-- Optional Description -->
              {service.description && service.description.trim() !== '' && (
                <p class="service-desc" set:html={service.description.replace(/\n/g, '<br/>')}></p>
              )}

              <!-- Features -->
              {service.features && service.features.length > 0 && (
                <div class="service-features-wrapper">
                  <span class="features-header-label">¿Qué incluye este servicio?</span>
                  <ul class="service-features">
                    {service.features.map((feature: string) => (
                      <li>
                        <div class="check-icon-wrapper">
                          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        </div>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Action Button -->
              <a href={`/contacto?servicio=${encodeURIComponent(service.name)}`} class="btn btn-primary service-card-btn">
                Solicitar Servicio
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section process-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Proceso</span>
          <h2>¿Cómo trabajamos juntos?</h2>
          <p>Un proceso simple y transparente para que te sientas acompañado en cada paso.</p>
        </div>
        <div class="process-grid">
          {steps.map((step, i) => (
            <div class={`process-step reveal delay-${i + 1}`}>
              <div class="process-num">{step.num}</div>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .services-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .service-detail-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #152750 0%, #0d1935 100%);
    color: white;
    border: 1px solid rgba(201, 168, 76, 0.35);
    border-radius: 20px;
    padding: var(--space-8);
    transition: all var(--transition-base);
    box-shadow: 0 12px 36px rgba(10, 19, 41, 0.35);
    position: relative;
    overflow: hidden;
    text-align: left;
  }

  .service-detail-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-gold-bar);
  }

  .service-detail-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 50px rgba(10, 19, 41, 0.45);
    border-color: var(--color-accent);
  }

  .service-card-top {
    margin-bottom: var(--space-4);
  }

  .service-icon-box {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 168, 76, 0.15);
    color: var(--color-accent);
    border-radius: 14px;
    border: 1px solid rgba(201, 168, 76, 0.3);
    margin-bottom: var(--space-4);
  }

  .service-name { 
    font-size: 1.4rem; 
    font-family: var(--font-heading);
    font-weight: 700;
    color: white;
    line-height: 1.28;
    min-height: 54px;
  }

  /* Pricing Box */
  .service-pricing-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 168, 76, 0.28);
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .service-pricing-box.evaluation {
    background: rgba(201, 168, 76, 0.08);
    border-color: rgba(201, 168, 76, 0.4);
  }

  .pricing-box-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: rgba(201, 168, 76, 0.9);
  }

  .pricing-box-val-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pricing-amount {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: #dfc374;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .pricing-eval-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: white;
    line-height: 1.1;
  }

  .pricing-eval-badge {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-accent);
    background: rgba(201, 168, 76, 0.16);
    border: 1px solid rgba(201, 168, 76, 0.4);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .service-desc { 
    font-size: 0.88rem; 
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.55;
    margin-bottom: var(--space-4);
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.15);
    border-radius: 8px;
  }

  /* Features */
  .service-features-wrapper {
    margin-bottom: var(--space-6);
  }

  .features-header-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--space-3);
  }

  .service-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.45;
  }

  .check-icon-wrapper {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(201, 168, 76, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .check-icon {
    color: var(--color-accent);
  }

  .service-card-btn {
    width: 100%;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 700;
    padding: 0.85rem 1.2rem;
    border-radius: 12px;
  }

  .process-section { background: var(--color-bg-alt); }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .process-step { text-align: center; }

  .process-num {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-accent);
    opacity: 0.5;
    margin-bottom: var(--space-3);
  }

  .process-step h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .process-step p { font-size: var(--text-sm); }

  @media (max-width: 1024px) {
    .services-detail-grid { grid-template-columns: repeat(2, 1fr); }
    .process-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .services-detail-grid, .process-grid { grid-template-columns: 1fr; }
  }
</style>
