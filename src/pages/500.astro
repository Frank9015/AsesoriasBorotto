---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
  title="Error del servidor | Asesorías Borotto"
  description="Ha ocurrido un error inesperado. Por favor intenta nuevamente."
>
  <Header />
  <main class="error-main">
    <div class="error-container">
      <div class="error-badge">500</div>
      <div class="error-icon">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity="0.2"/>
          <line x1="32" y1="20" x2="32" y2="36" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <circle cx="32" cy="44" r="2.5" fill="currentColor"/>
        </svg>
      </div>
      <h1 class="error-title">Algo salió mal</h1>
      <p class="error-description">
        Ocurrió un error inesperado en el servidor.<br />
        Por favor intenta nuevamente en unos momentos.
      </p>
      <div class="error-actions">
        <a href="/" class="btn-primary" id="btn-500-inicio">Volver al Inicio</a>
        <a href="/contacto" class="btn-secondary" id="btn-500-contacto">Contactar</a>
      </div>
      <p class="error-hint">
        Si el problema persiste, contáctanos directamente a<br />
        <a href="mailto:rossana.b@asesoriasborotto.cl">rossana.b@asesoriasborotto.cl</a>
      </p>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .error-main {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: linear-gradient(135deg, #f8f7f4 0%, #f5eef0 100%);
  }
  .error-container {
    text-align: center;
    max-width: 520px;
    animation: fadeInUp 0.6s ease-out;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .error-badge {
    font-size: clamp(5rem, 15vw, 8rem);
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #7b1d2a 0%, #c9a84c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -4px;
    margin-bottom: 1rem;
  }
  .error-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 1.5rem;
    color: #7b1d2a;
    opacity: 0.5;
  }
  .error-icon svg { width: 100%; height: 100%; }
  .error-title {
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    font-weight: 700;
    color: #1a2e5a;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .error-description {
    font-size: 1.05rem;
    color: #4a5568;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.8rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .btn-primary {
    background: #1a2e5a;
    color: #fff;
    box-shadow: 0 4px 15px rgba(26,46,90,0.3);
  }
  .btn-primary:hover {
    background: #c9a84c;
    box-shadow: 0 6px 20px rgba(201,168,76,0.35);
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: transparent;
    color: #1a2e5a;
    border: 2px solid #1a2e5a;
  }
  .btn-secondary:hover {
    background: #1a2e5a;
    color: #fff;
    transform: translateY(-2px);
  }
  .error-hint {
    font-size: 0.9rem;
    color: #718096;
    line-height: 1.6;
  }
  .error-hint a {
    color: #c9a84c;
    font-weight: 500;
    text-decoration: none;
  }
  .error-hint a:hover { text-decoration: underline; }
</style>
