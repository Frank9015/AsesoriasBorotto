---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
  title="Página no encontrada | Asesorías Borotto"
  description="La página que buscas no existe. Regresa al inicio de Asesorías Borotto."
>
  <Header />
  <main class="error-main">
    <div class="error-container">
      <div class="error-badge">404</div>
      <div class="error-icon">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2" opacity="0.2"/>
          <path d="M22 42s4-6 10-6 10 6 10 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="23" cy="27" r="3" fill="currentColor"/>
          <circle cx="41" cy="27" r="3" fill="currentColor"/>
        </svg>
      </div>
      <h1 class="error-title">Página no encontrada</h1>
      <p class="error-description">
        La página que buscas no existe o fue movida.<br />
        Pero podemos ayudarte desde aquí.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary btn-lg" id="btn-404-inicio">Ir al Inicio</a>
        <a href="/contacto" class="btn btn-secondary btn-lg" id="btn-404-contacto">Contactar</a>
      </div>
      <div class="error-links">
        <span>O visita:</span>
        <a href="/servicios">Servicios</a>
        <a href="/planes">Planes</a>
        <a href="/sobre-mi">Sobre Mí</a>
      </div>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .error-main {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: linear-gradient(135deg, #f8f7f4 0%, #eef1f8 100%);
  }
  .error-container {
    text-align: center;
    max-width: 520px;
    animation: fadeInUp 0.6s ease-out;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .error-badge {
    font-size: clamp(5rem, 15vw, 8rem);
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -4px;
    margin-bottom: 1rem;
  }
  .error-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 1.5rem;
    color: var(--color-primary);
    opacity: 0.5;
  }
  .error-icon svg { width: 100%; height: 100%; }
  .error-title {
    font-size: clamp(1.4rem, 4vw, 1.9rem);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .error-description {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .error-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }
  .error-links a {
    color: var(--color-accent-dark);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  .error-links a:hover { color: var(--color-primary); text-decoration: underline; }
</style>
