---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const education = [
  {
    degree: 'Master of Business Administration (MBA)',
    institution: 'Universidad de Santiago de Chile (USACH)',
    period: '2019 – 2021',
    honors: 'Con Distinción Máxima • Premio Espíritu MBA 2023',
    desc: 'Desarrollo de liderazgo estratégico, resolución de problemas complejos de negocio y gestión corporativa.'
  },
  {
    degree: 'Ingeniería Industrial',
    institution: 'Universidad Andrés Bello (UNAB)',
    period: '2015 – 2018',
    honors: 'Titulada con Distinción Máxima (Calificación Memoria: 6.7)',
    desc: 'Optimización de procesos, gestión operacional y evaluación financiera de proyectos.'
  },
  {
    degree: 'Contador Auditor',
    institution: 'Escuela de Contadores Auditores de Santiago (ECAS)',
    period: '2003 – 2008',
    honors: 'Título Profesional & Bachelor of Accountancy',
    desc: 'Formación integral en contabilidad general, tributaria, auditoría y administración de finanzas.'
  },
  {
    degree: 'Diplomado en Control de Gestión',
    institution: 'Universidad Adolfo Ibáñez (UAI)',
    period: '2021',
    honors: 'Especialización Ejecutiva',
    desc: 'Diseño e implementación de KPIs, tableros de control financieros y seguimiento estratégico.'
  },
  {
    degree: 'Diplomado en IFRS / NIIF',
    institution: 'Universidad de Santiago de Chile (USACH)',
    period: '2012 – 2013',
    honors: 'Especialización en Normas Internacionales de Contabilidad',
    desc: 'Marco conceptual, estados financieros consolidados y normativa contable internacional.'
  }
];
---

<Layout title="Sobre Mí | Rossana Borotto - Asesorías Borotto" description="Conoce a Rossana Borotto Vidal: Contador Auditor, Ingeniera Industrial y MBA USACH con más de 15 años de experiencia en control de gestión y finanzas en Chile.">
  <Header />
  <main>
    <Hero
      title='Rossana Borotto <span class="accent">Vidal</span>'
      subtitle="Contador Auditor | Ingeniera Industrial | MBA USACH | +15 Años de Experiencia en Control de Gestión & Finanzas"
      compact={true}
      ctaPrimary={{ text: 'Contactar Directamente', href: '/contacto' }}
      ctaSecondary={{ text: 'Ver Perfil LinkedIn', href: 'https://www.linkedin.com/in/rossana-borotto/', target: '_blank' }}
    />

    <!-- Bio Principal con Foto Oficial -->
    <section class="section">
      <div class="container">
        <div class="about-grid">
          <div class="about-photo-wrapper reveal-left">
            <img 
              src="/images/rossana-borotto-1.webp" 
              alt="Rossana Borotto Vidal - Contador Auditor y MBA" 
              class="about-photo-img" 
              loading="eager"
            />
            <div class="photo-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              <span>Espíritu MBA USACH 2023</span>
            </div>
          </div>
          <div class="about-content reveal-right">
            <span class="section-label">Trayectoria & Filosofía</span>
            <h2>Experiencia corporativa al servicio de tu emprendimiento</h2>
            <p>Con más de <strong>15 años</strong> de trayectoria profesional liderando análisis financieros, consolidación de estados financieros y control de gestión en organizaciones de alto nivel, mi compromiso es poner todo este conocimiento estratégico al alcance de pymes y emprendedores.</p>
            <p>Como <strong>Contador Auditor</strong>, <strong>Ingeniera Industrial</strong> y magíster del <strong>MBA USACH (Distinción Máxima)</strong>, entiendo que los números no son solo un cumplimiento tributario obligatorio: son la brújula que impulsa la rentabilidad y el crecimiento sostenible de tu negocio.</p>
            <p>Mi enfoque combina rigurosidad técnica, actualización constante en normativas IFRS/NIIF y una atención cercana y transparente. En Asesorías Borotto, tu empresa no es un número de RUT más; es un proyecto que acompañamos con responsabilidad y ética.</p>
            
            <div class="about-actions mt-6">
              <a href="https://www.linkedin.com/in/rossana-borotto/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary linkedin-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                Ver Perfil Completo en LinkedIn
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Formación Académica & Credenciales -->
    <section class="section education-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Formación & Respaldo</span>
          <h2>Educación y Credenciales Académicas</h2>
          <p>Un sólido respaldo académico en las universidades más prestigiosas de Chile para garantizar la máxima calidad en cada asesoría.</p>
        </div>

        <div class="education-timeline">
          {education.map((item, index) => (
            <div class={`education-card card reveal delay-${index + 1}`}>
              <div class="edu-header">
                <div class="edu-badge">{item.period}</div>
                <span class="edu-honors">{item.honors}</span>
              </div>
              <h3 class="edu-degree">{item.degree}</h3>
              <h4 class="edu-institution">{item.institution}</h4>
              <p class="edu-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Galería de Fotos Profesionales -->
    <section class="section gallery-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Galería</span>
          <h2>Presencia Profesional & Compromiso</h2>
        </div>
        <div class="gallery-grid">
          <div class="gallery-item reveal delay-1">
            <img src="/images/rossana-borotto-2.webp" alt="Rossana Borotto - Asesora Contable" loading="lazy" />
          </div>
          <div class="gallery-item reveal delay-2">
            <img src="/images/rossana-borotto-3.webp" alt="Rossana Borotto - Control de Gestión" loading="lazy" />
          </div>
          <div class="gallery-item reveal delay-3">
            <img src="/images/rossana-borotto-4.webp" alt="Rossana Borotto - Reunión de Asesoría" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Valores -->
    <section class="section values-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Valores Corporativos</span>
          <h2>Lo que define mi trabajo</h2>
        </div>
        <div class="values-grid">
          <div class="card value-card reveal delay-1">
            <div class="value-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <h3>Cercanía & Empatía</h3>
            <p>Atención personalizada y directa. Traduzco los conceptos contables complejos a un lenguaje claro y comprensible.</p>
          </div>
          <div class="card value-card reveal delay-2">
            <div class="value-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3>Rigor & Transparencia</h3>
            <p>Cumplimiento estricto de normativas IFRS y normativa tributaria vigente del SII, sin letras chicas.</p>
          </div>
          <div class="card value-card reveal delay-3">
            <div class="value-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Ética & Confidencialidad</h3>
            <p>Tu información contable y financiera está 100% protegida bajo los más altos estándares éticos de auditoría.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Misión y Visión -->
    <section class="section">
      <div class="container">
        <div class="mission-grid">
          <div class="card-glass mission-card reveal delay-1">
            <span class="section-label">Misión</span>
            <h3>Impulsar el crecimiento de tu Pyme</h3>
            <p>Proporcionar un servicio contable, tributario y de auditoría de excelencia ejecutiva a emprendedores y empresas en Chile, liberándote de cargas administrativas para que te enfoques en escalar tu negocio.</p>
          </div>
          <div class="card-glass mission-card reveal delay-2">
            <span class="section-label">Visión</span>
            <h3>Aliada financiera estratégica</h3>
            <p>Ser la firma de asesoría contable de referencia por su ética, rigor técnico y cercanía humana, acompañando a cada cliente a alcanzar el éxito comercial con tranquilidad fiscal.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about-photo-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 3px solid var(--color-accent);
  }

  .about-photo-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 3/4;
    transition: transform var(--transition-slow);
  }

  .about-photo-wrapper:hover .about-photo-img {
    transform: scale(1.03);
  }

  .photo-badge {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    background: rgba(19, 37, 78, 0.9);
    backdrop-filter: blur(10px);
    color: var(--color-accent);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    border: 1px solid rgba(201, 168, 76, 0.4);
  }

  .about-content p {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    background: #0077b5;
    color: white;
    border-color: #0077b5;
  }

  .linkedin-btn:hover {
    background: #005582;
    border-color: #005582;
    color: white;
  }

  /* Education Timeline */
  .education-section {
    background: var(--color-bg-alt);
  }

  .education-timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .education-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border-left: 4px solid var(--color-accent);
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .edu-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(201, 168, 76, 0.2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .edu-honors {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-dark);
  }

  .edu-degree {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-1);
  }

  .edu-institution {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .edu-desc {
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.6;
  }

  /* Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .gallery-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Values Section */
  .values-section {
    background: var(--color-bg);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .value-card {
    text-align: center;
  }

  .value-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.1), rgba(201, 168, 76, 0.05));
    color: var(--color-accent);
    border-radius: 50%;
    margin: 0 auto var(--space-4);
  }

  .value-card h3 {
    margin-bottom: var(--space-2);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .mission-card {
    text-align: center;
    padding: var(--space-10);
  }

  .mission-card h3 {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 1024px) {
    .education-timeline {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .gallery-grid,
    .values-grid,
    .mission-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

