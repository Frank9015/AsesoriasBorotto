---
import { prisma } from '../lib/prisma';

interface Props {
  services?: { id?: number; name: string }[];
}

const { services: propServices } = Astro.props;

const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-mi', label: 'Sobre Mí' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/planes', label: 'Planes' },
  { href: '/testimonios', label: 'Testimonios' },
  { href: '/contacto', label: 'Contacto' },
];

let services = propServices;
if (!services) {
  try {
    services = await prisma.service.findMany({
      select: { id: true, name: true },
      orderBy: { order: 'asc' },
    });
  } catch (error) {
    console.error('Error loading services in Footer:', error);
    services = [];
  }
}
---

<footer class="footer" id="main-footer">
  <div class="footer-wave">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0,60 C360,120 720,0 1080,60 C1260,90 1380,40 1440,60 L1440,120 L0,120 Z" fill="var(--color-primary)"/>
    </svg>
  </div>

  <div class="footer-body">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand -->
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/logo-light.png?v=4" alt="Asesorías Borotto" class="footer-logo-img" />
          </div>
          <p class="footer-desc">
            Servicios profesionales de contabilidad, auditoría y asesoría tributaria. 
            Tu tranquilidad financiera es mi prioridad.
          </p>
        </div>

        <!-- Enlaces -->
        <div class="footer-section">
          <h4 class="footer-title">Navegación</h4>
          <ul class="footer-links">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Servicios -->
        <div class="footer-section">
          <h4 class="footer-title">Servicios</h4>
          <ul class="footer-links">
            {services.map((service) => (
              <li><a href="/servicios">{service.name}</a></li>
            ))}
          </ul>
        </div>

        <!-- Contacto -->
        <div class="footer-section">
