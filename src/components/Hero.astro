---
interface Props {
  title: string;
  subtitle: string;
  ctaPrimary?: { text: string; href: string };
  ctaSecondary?: { text: string; href: string };
  compact?: boolean;
  image?: string;
  imageAlt?: string;
  tagline?: string;
}

const {
  title,
  subtitle,
  ctaPrimary = { text: 'Ver Planes', href: '/planes' },
  ctaSecondary = { text: 'Contactar', href: '/contacto' },
  compact = false,
  image,
  imageAlt = 'Rossana Borotto - Asesorías Contables',
  tagline = 'Asesoría Contable & Tributaria Estratégica',
} = Astro.props;
---

<section class:list={['hero', { 'hero-compact': compact, 'hero-split': !!image }]} id="hero">
  <!-- Decorative ambient shapes -->
  <div class="hero-shapes" aria-hidden="true">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
    <div class="shape shape-4"></div>
  </div>

  <div class="container hero-container">
    {image ? (
      <div class="hero-grid">
        <div class="hero-text-col">
          {tagline && (
            <div class="hero-tagline">
              <span class="tagline-dot"></span>
              <span>{tagline}</span>
            </div>
          )}
          <h1 class="hero-title" set:html={title} />
          <p class="hero-subtitle">{subtitle}</p>
          
          <div class="hero-ctas">
            <a href={ctaPrimary.href} class="btn btn-primary btn-lg">{ctaPrimary.text}</a>
            <a href={ctaSecondary.href} class="btn btn-secondary btn-lg">{ctaSecondary.text}</a>
          </div>

          <div class="hero-trust-badges">
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trust-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>+15 Años de Experiencia</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trust-icon"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              <span>MBA USACH</span>
            </div>
            <div class="trust-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="trust-icon"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span>100% Ética y Cercanía</span>
            </div>
          </div>
        </div>

        <div class="hero-image-col">
          <div class="hero-image-frame">
            <div class="hero-image-glow"></div>
            <div class="hero-image-wrapper">
              <img 
                src={image} 
                alt={imageAlt} 
                class="hero-portrait"
                loading="eager"
                fetchpriority="high"
              />
            </div>

            <!-- Floating prestige badge 1 -->
            <div class="floating-badge badge-top-right">
              <div class="badge-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <div class="badge-text-box">
                <strong>MBA USACH</strong>
                <small>Distinción Máxima</small>
              </div>
            </div>

            <!-- Floating prestige badge 2 -->
            <div class="floating-badge badge-bottom-left">
              <div class="badge-icon-box gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              </div>
              <div class="badge-text-box">
                <strong>Contadora Auditora</strong>
                <small>Ingeniera Industrial</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="hero-content">
        <h1 class="hero-title" set:html={title} />
        <p class="hero-subtitle">{subtitle}</p>
        <div class="hero-ctas">
          <a href={ctaPrimary.href} class="btn btn-primary btn-lg">{ctaPrimary.text}</a>
          <a href={ctaSecondary.href} class="btn btn-secondary btn-lg">{ctaSecondary.text}</a>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 50%, rgba(201, 168, 76, 0.08) 100%);
    overflow: hidden;
    padding-top: 100px;
    padding-bottom: 60px;
  }

  .hero-compact {
    min-height: 48vh;
    padding-top: 80px;
    padding-bottom: 40px;
  }

  /* Decorative shapes */
  .hero-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.45;
  }

  .shape-1 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.22), transparent 70%);
    top: -100px;
    right: -80px;
    animation: float 8s ease-in-out infinite;
  }

  .shape-2 {
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(45, 74, 122, 0.18), transparent 70%);
    bottom: -50px;
    left: -50px;
    animation: float 10s ease-in-out infinite 1s;
  }

  .shape-3 {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.15), transparent 70%);
    top: 35%;
    left: 45%;
    animation: float 7s ease-in-out infinite 2s;
  }

  .shape-4 {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(26, 39, 68, 0.1), transparent 70%);
    bottom: 20%;
    right: 15%;
    animation: float 9s ease-in-out infinite 0.5s;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Centered mode (Compact) */
  .hero-content {
    max-width: 750px;
    margin-inline: auto;
    text-align: center;
    animation: fadeInUp 0.8s ease both;
  }

  /* Split mode (2 Columns) */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-text-col {
    animation: fadeInLeft 0.8s ease both;
  }

  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.95rem;
    background: rgba(201, 168, 76, 0.12);
    border: 1px solid rgba(201, 168, 76, 0.35);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }

  .tagline-dot {
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-accent);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: var(--space-5);
    color: var(--color-primary);
    font-family: var(--font-heading);
  }

  .hero-title :global(.accent) {
    background: linear-gradient(135deg, #c9a84c 0%, #dfc374 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    line-height: 1.7;
    max-width: 580px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .hero-text-col .hero-ctas {
    justify-content: flex-start;
  }

  .hero-trust-badges {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(19, 37, 78, 0.08);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
  }

  .trust-icon {
    width: 17px;
    height: 17px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Image Column */
  .hero-image-col {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fadeInRight 0.8s ease both;
  }

  .hero-image-frame {
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .hero-image-glow {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.3) 0%, rgba(19, 37, 78, 0.15) 70%, transparent 100%);
    border-radius: 36px;
    filter: blur(20px);
    z-index: 0;
  }

  .hero-image-wrapper {
    position: relative;
    z-index: 1;
    border-radius: 28px;
    overflow: hidden;
    border: 2px solid rgba(201, 168, 76, 0.45);
    box-shadow: 0 25px 50px -12px rgba(19, 37, 78, 0.25);
    background: linear-gradient(180deg, rgba(255,255,255,0.8), rgba(240,242,248,0.9));
    aspect-ratio: 3 / 4;
  }

  .hero-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 0.5s ease;
  }

  .hero-image-frame:hover .hero-portrait {
    transform: scale(1.03);
  }

  /* Floating Prestige Badges */
  .floating-badge {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 30px rgba(19, 37, 78, 0.15);
    border: 1px solid rgba(201, 168, 76, 0.3);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    animation: float 6s ease-in-out infinite;
  }

  .badge-top-right {
    top: 25px;
    right: -25px;
    animation-delay: 0.5s;
  }

  .badge-bottom-left {
    bottom: 30px;
    left: -25px;
    animation-delay: 2s;
  }

  .badge-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(19, 37, 78, 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-icon-box svg {
    width: 20px;
    height: 20px;
  }

  .badge-icon-box.gold {
    background: rgba(201, 168, 76, 0.18);
    color: #9b7824;
  }

  .badge-text-box {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .badge-text-box strong {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .badge-text-box small {
    font-size: 10px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(-30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      text-align: center;
    }

    .hero-text-col {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-subtitle {
      margin-inline: auto;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-trust-badges {
      justify-content: center;
    }

    .hero-image-frame {
      max-width: 360px;
      margin-top: var(--space-4);
    }

    .badge-top-right {
      right: -10px;
    }

    .badge-bottom-left {
      left: -10px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-top: 110px;
      padding-bottom: 50px;
    }

    .hero-title {
      font-size: 2.2rem;
    }

    .floating-badge {
      display: none;
    }

    .hero-image-frame {
      max-width: 290px;
    }
  }
</style>
