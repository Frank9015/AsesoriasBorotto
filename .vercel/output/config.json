{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/mensajes/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/planes/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/servicios/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/testimonios/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/planes/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/review-token/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/servicios/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/submit-review/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/testimonios/?$",
			"dest": "_render"
		},
		{
			"src": "^/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/planes/?$",
			"dest": "_render"
		},
		{
			"src": "^/resena/?$",
			"dest": "_render"
		},
		{
			"src": "^/servicios/?$",
			"dest": "_render"
		},
		{
			"src": "^/sobre-mi/?$",
			"dest": "_render"
		},
		{
			"src": "^/testimonios/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}